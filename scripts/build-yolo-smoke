#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
BUILD_DIR=/workspace/build/echo-mate-yolo-smoke
INSTALL_DIR=/workspace/install/echo-mate-yolo-smoke
HOST_OUTPUT="${PROJECT_DIR}/out/yolo-smoke"

mkdir -p "${HOST_OUTPUT}"

docker compose -f "${PROJECT_DIR}/compose.yaml" run --rm sdk bash -lc "
  set -euo pipefail
  cmake \
    -S /host-project/apps/yolo-smoke \
    -B ${BUILD_DIR} \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/host-project/apps/yolo-smoke/cmake/rv1106-toolchain.cmake \
    -DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}
  cmake --build ${BUILD_DIR} --parallel 4
  cmake --install ${BUILD_DIR}
"

docker compose -f "${PROJECT_DIR}/compose.yaml" run --rm \
  -v "${HOST_OUTPUT}:/export" sdk bash -lc "
    set -euo pipefail
    cp -a ${INSTALL_DIR}/. /export/
  "

echo "YOLO smoke package: ${HOST_OUTPUT}"
