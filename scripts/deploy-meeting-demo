#!/usr/bin/env bash
# 部署并运行 meeting_demo（会议纪要助手板端 demo）
#
# 流程：构建（可选）→ 推送 /root/meeting_demo → 板端调教音频参数 → 前台运行
# 默认只运行会议纪要链路；前台按 q 或 Ctrl+C 结束会议并生成纪要。
#
# 用法:
#   scripts/deploy-meeting-demo [--no-build] [--server ws://HOST:PORT]
#                               [--mode listen|host|full] [--auto-host-every N]
#                               [--local-mock]
#
# --local-mock：把纯 stdlib mock 后端一并部署到板端并在板端
#   常驻启动，demo 用 ws://127.0.0.1:8700 回环连接，不依赖 Wi-Fi/外网。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
MOCK_SRC="${PROJECT_DIR}/../confer-sum/mock-server"
PACKAGE_DIR="${PROJECT_DIR}/out/meeting-demo"
RUNNER_SRC="${PROJECT_DIR}/scripts/board/meeting-demo-run.sh"
DNS_HOOK_SRC="${PROJECT_DIR}/scripts/board/meeting-dns-hook.sh"
REMOTE_DIR=/root/meeting_demo
REMOTE_MOCK=/root/mock-server
REMOTE_DNS_HOOK=/usr/share/udhcpc/default.script.d/50-meeting-public-dns
SERVER="wss://clare.vinex.top/voice-api"
MODE=listen
EXTRA_ARGS=""
build=1
local_mock=0

usage() {
  cat <<'USAGE_EOF'
Usage: scripts/deploy-meeting-demo [--no-build] [--server ws://HOST:PORT]
                                  [--mode listen|host|full] [--auto-host-every N]
                                  [--local-mock]

Builds, deploys, and runs the meeting-minutes demo in listen mode by default.
Press q or Ctrl+C to end the meeting and generate the final minutes.
Host/full modes remain available only for explicit compatibility testing.
--local-mock deploys the stdlib mock backend onto the board (loopback).
USAGE_EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --no-build) build=0 ;;
    --server) SERVER="$2"; shift ;;
    --mode) MODE="$2"; shift ;;
    --auto-host-every)
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "error: --auto-host-every must be a positive integer" >&2; exit 2; }
      EXTRA_ARGS="--auto-host-every $2"
      shift
      ;;
    --local-mock) local_mock=1; SERVER="ws://127.0.0.1:8700" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if ! adb devices | grep -qw device; then
  echo "error: no ADB device (board offline?)" >&2
  exit 1
fi

if [[ "$build" -eq 1 ]]; then
  "${SCRIPT_DIR}/build-meeting-demo"
fi
test -x "${PACKAGE_DIR}/meeting_demo"
test -f "${RUNNER_SRC}"
test -f "${DNS_HOOK_SRC}"

adb shell "mkdir -p ${REMOTE_DIR}" >/dev/null
adb push "${PACKAGE_DIR}/." "${REMOTE_DIR}/" >/dev/null
adb push "${RUNNER_SRC}" "${REMOTE_DIR}/meeting-demo-run.sh" >/dev/null
adb push "${DNS_HOOK_SRC}" "${REMOTE_DNS_HOOK}" >/dev/null
adb shell "chmod 0755 ${REMOTE_DIR}/meeting_demo ${REMOTE_DIR}/meeting-demo-run.sh"
adb shell "chmod 0755 ${REMOTE_DNS_HOOK} && ${REMOTE_DNS_HOOK} apply"

# 本地 mock：部署纯 stdlib 后端到板端并常驻（不依赖 Wi-Fi）
if [[ "$local_mock" -eq 1 ]]; then
  test -f "${MOCK_SRC}/mock_server_stdlib.py"
  adb shell "mkdir -p ${REMOTE_MOCK}/assets" >/dev/null
  adb push "${MOCK_SRC}/mock_server_stdlib.py" "${REMOTE_MOCK}/" >/dev/null
  adb push "${MOCK_SRC}/assets/s1.mp3" "${MOCK_SRC}/assets/s2.mp3" \
           "${MOCK_SRC}/assets/s3.mp3" "${REMOTE_MOCK}/assets/" >/dev/null
  adb shell "if [ -f /tmp/meeting-mock.pid ]; then \
      old_pid=\$(cat /tmp/meeting-mock.pid); kill \"\$old_pid\" 2>/dev/null || true; \
      rm -f /tmp/meeting-mock.pid; \
    fi; \
    for pid in \$(ps | awk '\$3 == "/usr/bin/python3" && \
                               \$4 == "mock_server_stdlib.py" {print \$1}'); do \
      kill \"\$pid\" 2>/dev/null || true; \
    done; \
    sleep 1; cd ${REMOTE_MOCK} && \
    start-stop-daemon -S -b -m -p /tmp/meeting-mock.pid -x /usr/bin/python3 -- \
    mock_server_stdlib.py --port 8700 --assets ${REMOTE_MOCK}/assets" >/dev/null
  sleep 2
  if ! adb shell "wget -q -T 3 -O - http://127.0.0.1:8700/health" | grep -q '"ok"'; then
    echo "error: board mock failed to start" >&2
    exit 1
  fi
  echo "board mock up at ws://127.0.0.1:8700"
fi

# 板端运行（前台，保留交互）
echo "running meeting_demo: server=${SERVER} mode=${MODE}"
if [[ "${MODE}" == "listen" ]]; then
  echo "（q/Ctrl+C=结束会议并生成纪要）"
else
  echo "（Enter=提问/结束提问  s=打断  q/Ctrl+C=结束）"
fi
set +e
adb shell "APP=${REMOTE_DIR} SERVER=${SERVER} MODE=${MODE} EXTRA_ARGS=\"${EXTRA_ARGS}\" ${REMOTE_DIR}/meeting-demo-run.sh" 2>&1 \
  | tr -d '\r' | tee "${PROJECT_DIR}/out/meeting-demo-run.log"
adb_status=${PIPESTATUS[0]}
set -e
if [[ "$adb_status" -ne 0 ]]; then
  echo "error: board meeting demo exited with ${adb_status}" >&2
  exit "$adb_status"
fi
echo "done"
